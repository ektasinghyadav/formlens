{
  "name": "dfua-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file=../.env server.js",
    "start": "node --env-file=../.env server.js",
    "db:init": "node --env-file=../.env scripts/dbInit.js",
    "test": "node --env-file=../.env node_modules/vitest/vitest.mjs run",
    "seed": "node --env-file=../.env scripts/seed.js",
    "purge": "node --env-file=../.env scripts/purgeOldEvents.js",
    "loadtest": "node --env-file=../.env scripts/loadTest.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
