# Copy to .env and fill in. Never commit .env.
PORT=3000
DB_HOST=localhost
DB_USER=dfua_user
DB_PASSWORD=change_me
DB_NAME=dfua
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
IP_HASH_SALT=change_me_to_a_random_string
EVENT_RETENTION_DAYS=180
CLIENT_ORIGIN=http://localhost:5173

# Optional: recommendation cut-offs (defaults are in server/config/thresholds.js).
# Metrics: ABANDONMENT, ERROR, CORRECTION (0-1 fractions) and TIME_MS (milliseconds); tiers: LOW, MEDIUM, HIGH.
# THRESHOLD_ABANDONMENT_HIGH=0.30
# THRESHOLD_TIME_MS_MEDIUM=20000
# THRESHOLD_MIN_SESSIONS=5
